            "body": { "mode": "raw", "raw": "{\n  \"skillId\": {{skillId}},\n  \"level\": 4,\n  \"observations\": \"Asignación de prueba\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/players/{{playerId}}/skills"
          }
        },
        { "name": "GET - Listar habilidades del jugador", "request": { "method": "GET", "url": "{{baseUrl}}/players/{{playerId}}/skills" } },
        { "name": "GET - Listar jugadores con la habilidad", "request": { "method": "GET", "url": "{{baseUrl}}/skills/{{skillId}}/players" } },
        {
          "name": "PATCH - Actualizar habilidad del jugador",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"level\": 5,\n  \"observations\": \"Nivel actualizado desde Postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/players/{{playerId}}/skills/{{skillId}}"
          }
        },
        { "name": "DELETE - Quitar habilidad del jugador (manual)", "request": { "method": "DELETE", "url": "{{baseUrl}}/players/{{playerId}}/skills/{{skillId}}" } }
      ]
    },
    {
      "name": "player-teams",
      "item": [
        {
          "name": "POST - Vincular jugador principal a equipo A",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('today', new Date().toISOString().slice(0, 10));"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('playerTeamId', pm.response.json().playerTeamId);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": {{playerId}},\n  \"startDate\": \"{{today}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/teams/{{teamAId}}/players"
          }
        },
        { "name": "GET - Jugadores actuales del equipo A", "request": { "method": "GET", "url": "{{baseUrl}}/teams/{{teamAId}}/players?current=true" } },
        { "name": "GET - Equipos del jugador", "request": { "method": "GET", "url": "{{baseUrl}}/players/{{playerId}}/teams" } },
        {
          "name": "PATCH - Retirar jugador del equipo (ejecutar después de annotations)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"endDate\": \"{{today}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/teams/{{teamAId}}/players/{{playerId}}/retirement"
          }
        },
        {
          "name": "POST - Crear asignación programada",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const date = new Date();", "date.setDate(date.getDate() + 30);", "pm.collectionVariables.set('futureDate', date.toISOString().slice(0, 10));"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('scheduledPlayerTeamId', pm.response.json().playerTeamId);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": {{scheduledPlayerId}},\n  \"startDate\": \"{{futureDate}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/teams/{{teamBId}}/players"
          }
        },
        { "name": "DELETE - Eliminar asignación programada (manual)", "request": { "method": "DELETE", "url": "{{baseUrl}}/player-teams/{{scheduledPlayerTeamId}}" } }
      ]
    },
    {
      "name": "annotations",
      "item": [
        {
          "name": "POST - Crear anotación",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code >= 200 && pm.response.code < 300) pm.collectionVariables.set('annotationId', pm.response.json().annotationId);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": {{playerId}},\n  \"minute\": 15,\n  \"type\": \"GOAL\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/matches/{{matchId}}/annotations"
          }
        },
        { "name": "GET - Listar anotaciones del partido", "request": { "method": "GET", "url": "{{baseUrl}}/matches/{{matchId}}/annotations" } },
        {
          "name": "PATCH - Actualizar anotación",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"minute\": 16,\n  \"type\": \"GOAL\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/annotations/{{annotationId}}"
          }
        },
        { "name": "DELETE - Anular anotación (manual)", "request": { "method": "DELETE", "url": "{{baseUrl}}/annotations/{{annotationId}}" } }
      ]
    }
  ]
}
